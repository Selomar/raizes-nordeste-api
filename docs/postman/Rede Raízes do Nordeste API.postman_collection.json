      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Login - Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resposta = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Login realizado com sucesso\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", resposta.access_token);\r",
                  "\r",
                  "console.log(\"Token salvo:\", pm.environment.get(\"token\") ? \"SIM\" : \"NÃO\");"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"insira seu e-mail aqui\",\n  \"senha\": \"insira a senha\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consultar usuário autenticado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resposta = pm.response.json();",
                  "",
                  "pm.test(\"Consulta do usuário autenticado retorna 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Usuário autenticado possui perfil ADMIN\", function () {",
                  "    pm.expect(resposta.perfil).to.eql(\"ADMIN\");",
                  "});",
                  "",
                  "// Descobre os IDs pelo conteúdo do banco, sem presumir sequência de IDs.",
                  "const base = pm.environment.get(\"base_url\");",
                  "const token = pm.environment.get(\"token\");",
                  "const headers = { \"Authorization\": \"Bearer \" + token };",
                  "",
                  "function buscar(path, callback) {",
                  "    pm.sendRequest({ url: base + path, method: \"GET\", header: headers }, function (err, response) {",
                  "        if (err || response.code !== 200) {",
                  "            console.error(\"Falha ao consultar \" + path, err || response.text());",
                  "            return;",
                  "        }",
                  "        callback(response.json());",
                  "    });",
                  "}",
                  "",
                  "buscar(\"/catalogo/clientes\", function(clientes) {",
                  "    buscar(\"/catalogo/unidades\", function(unidades) {",
                  "        buscar(\"/catalogo/produtos\", function(produtos) {",
                  "            const cliente = clientes.find(x => x.email === \"joao.silva@exemplo.com\");",
                  "            const unidade = unidades.find(x => x.nome === \"Unidade Centro\");",
                  "            const unidade2 = unidades.find(x => x.nome === \"Unidade Norte\");",
                  "            const tapioca = produtos.find(x => x.nome === \"Tapioca de queijo\");",
                  "            const baiao = produtos.find(x => x.nome === \"Baião de dois\");",
                  "            const bolo = produtos.find(x => x.nome === \"Bolo de milho\");",
                  "            const pingado = produtos.find(x => x.nome === \"Pingado\");",
                  "            const cuscuz = produtos.find(x => x.nome === \"Cuscuz nordestino\");",
                  "",
                  "            if (![cliente, unidade, unidade2, tapioca, baiao, bolo, pingado, cuscuz].every(Boolean)) {",
                  "                console.error(\"Seed incompleto: não foi possível localizar todos os registros esperados.\");",
                  "                return;",
                  "            }",
                  "",
                  "            const cv = pm.collectionVariables;",
                  "            cv.set(\"cliente_id\", cliente.id);",
                  "            cv.set(\"unidade_id\", unidade.id);",
                  "            cv.set(\"unidade_secundaria_id\", unidade2.id);",
                  "            cv.set(\"produto_pedido_a_id\", tapioca.id);",
                  "            cv.set(\"produto_pedido_b_id\", baiao.id);",
                  "            cv.set(\"produto_recusa_a_id\", bolo.id);",
                  "            cv.set(\"produto_recusa_b_id\", pingado.id);",
                  "            cv.set(\"produto_estoque_id\", cuscuz.id);",
                  "            cv.set(\"produto_inexistente_id\", Math.max.apply(null, produtos.map(x => x.id)) + 1);",
                  "            cv.set(\"cliente_inexistente_id\", Math.max.apply(null, clientes.map(x => x.id)) + 1);",
                  "            cv.set(\"unidade_inexistente_id\", Math.max.apply(null, unidades.map(x => x.id)) + 1);",
                  "",
                  "            buscar(\"/catalogo/estoques?produto_id=\" + cuscuz.id + \"&unidade_id=\" + unidade.id, function(estoque) {",
                  "                cv.set(\"quantidade_estoque_teste\", Number(estoque.quantidade) + 1);",
                  "                cv.set(\"catalogo_carregado\", \"true\");",
                  "                console.log(\"Catálogo carregado. IDs descobertos automaticamente.\");",
                  "            });",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
