        {
          "name": "Criar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const resposta = pm.response.json();\r\n\r\npm.test(\"Pedido criado com sucesso\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Status inicial do pedido é PENDENTE\", function () {\r\n    pm.expect(resposta.status).to.eql(\"PENDENTE\");\r\n});\r\n\r\npm.test(\"Valor total calculado corretamente\", function () {\r\n    pm.expect(resposta.valor_total).to.eql(24);\r\n});\r\n\r\npm.environment.set(\"pedido_id\", resposta.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"cliente_id\": 1,\r\n  \"unidade_id\": 1,\r\n  \"canal_pedido\": \"APP\",\r\n  \"itens\": [\r\n    {\r\n      \"produto_id\": 2,\r\n      \"quantidade\": 1\r\n    },\r\n    {\r\n      \"produto_id\": 4,\r\n      \"quantidade\": 2\r\n    }\r\n  ]\r\n}",
