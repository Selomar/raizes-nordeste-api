                "exec": [
                  "const resposta = pm.response.json();\r\n\r\npm.test(\"Pagamento processado com sucesso\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Pagamento aprovado\", function () {\r\n    pm.expect(resposta.status_pagamento).to.eql(\"APROVADO\");\r\n});\r\n\r\npm.test(\"Pedido atualizado para PAGO\", function () {\r\n    pm.expect(resposta.status_pedido).to.eql(\"PAGO\");\r\n});\r\n\r\npm.test(\"Valor do pagamento correto\", function () {\r\n    pm.expect(resposta.valor).to.eql(24);\r\n});"
                ]
